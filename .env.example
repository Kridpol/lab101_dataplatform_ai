# Non-secret settings only. Passwords and keys live in ./secrets (run: bash scripts/gen_secrets.sh).
# Lab values; change for any real deployment.

TIMEZONE=Asia/Bangkok

# Postgres (source)
SRC_PG_PORT=5433
SRC_PG_DB=shopdb
SRC_PG_ADMIN_USER=postgres
AIRBYTE_PG_USER=airbyte

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_AIRBYTE_USER=airbyte
CLICKHOUSE_LOADER_USER=loader
CLICKHOUSE_DBT_USER=dbt

# SeaweedFS
SEAWEEDFS_BUCKET=landing
SEAWEEDFS_UI_USER=admin

# Dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PORT=5434

# Airbyte (copy both IDs from the connection URL in the Airbyte UI)
AIRBYTE_WORKSPACE_ID=
AIRBYTE_CONNECTION_ID=
